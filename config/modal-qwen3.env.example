# Tên ứng dụng và hàm trên Modal. Giữ mặc định nếu không có ứng dụng riêng.
AGQO_QWEN3_MODAL_APP=agqo-qwen3-guide
AGQO_QWEN3_MODAL_FUNCTION=guide_qaoa_policy

# Mô hình và bản trọng số đã ghim để tái lập cùng một lần chạy.
AGQO_QWEN3_MODEL=Qwen/Qwen3-4B
AGQO_QWEN3_REVISION=1cfa9a7208912126459214e8b04321603b3df60c

# Volume chỉ giữ bộ nhớ đệm trọng số Qwen3 trên Modal.
AGQO_QWEN3_VOLUME=agqo-qwen3-model-cache

# Chỉ bỏ dấu # và điền nếu tài khoản có nhiều môi trường Modal.
# MODAL_ENVIRONMENT=REPLACE_WITH_MODAL_ENVIRONMENT_NAME

# Không đặt MODAL_TOKEN_ID hoặc MODAL_TOKEN_SECRET trong tệp này.
# Xác thực an toàn bằng lệnh modal setup; token sẽ được lưu trong hồ sơ Modal cá nhân.
