# Tên ứng dụng và lớp suy luận trên Modal. Giữ mặc định nếu không có ứng dụng riêng.
AGQO_QWEN38_MODAL_APP=agqo-qwen38-guide
AGQO_QWEN38_MODAL_CLASS=Qwen38Guide

# Mô hình và bản trọng số đã ghim để tái lập cùng một lần chạy (FP8 chính thức).
AGQO_QWEN38_MODEL=Qwen/Qwen3.8-27B-FP8
AGQO_QWEN38_REVISION=c3a462cc3d38cf351f3b26cbd763469eeb74ef81
AGQO_QWEN38_REASONING_EFFORT=medium

# Phần cứng và vLLM: 1×H100 80 GB đủ cho ~31 GB trọng số FP8 và KV cache.
AGQO_QWEN38_GPU=H100:1
AGQO_QWEN38_MAX_MODEL_LEN=65536
AGQO_QWEN38_MAX_NEW_TOKENS=16384
# Bật giải mã suy đoán MTP (nhanh hơn, thêm rủi ro tương thích) bằng 1.
AGQO_QWEN38_MTP=0

# Volume chỉ giữ trọng số Qwen3.8-27B trên Modal.
AGQO_QWEN38_VOLUME=agqo-qwen38-weights

# Chỉ bỏ dấu # và điền nếu tài khoản có nhiều môi trường Modal.
# MODAL_ENVIRONMENT=REPLACE_WITH_MODAL_ENVIRONMENT_NAME

# Không đặt MODAL_TOKEN_ID hoặc MODAL_TOKEN_SECRET trong tệp này.
# Xác thực an toàn bằng lệnh modal setup; token sẽ được lưu trong hồ sơ Modal cá nhân.
